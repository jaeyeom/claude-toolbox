{
  "description": "Blocks dangerous git and find commands",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/git-guardrails.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
