{
  "description": "Enforces -p/--project flag on jira issue create commands",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/jira-project-flag.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
