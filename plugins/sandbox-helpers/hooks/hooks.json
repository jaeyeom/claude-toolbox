{
  "description": "Warns about macOS sandbox TLS failures for Go CLI tools (gh, jira, circleci)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sandbox-tls-warning.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
