{
  "description": "Redirects 'git push' to 'review-and-push-loop'",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/review-push-loop.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
